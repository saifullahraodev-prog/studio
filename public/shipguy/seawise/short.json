 "beats": [
  {
   "tpl": "attack",
   "p": {
    "music": "tense"
   },
   "cap": "[MAY 1988]",
   "from": 0,
   "dur": 195,
   "say": "In May 1988, fighter jets fired missiles at the biggest ship humans have ever built."
  },
  {
   "tpl": "sea",
   "p": {
    "mood": "dusk",
    "state": "fire",
    "cam": "close"
   },
   "cap": "TOTAL LOSS",
   "from": 195,
   "dur": 163,
   "say": "The ship burst into flames, and its owners wrote it off as a total loss."
  },
  {
   "tpl": "upright",
   "p": {},
   "cap": "",
   "from": 358,
   "dur": 214,
   "say": "This ship was four hundred and fifty-eight metres long. Stand it on its end, and it's taller than the Petronas Towers."
  },
  {
   "tpl": "gates",
   "p": {},
   "cap": "",
   "from": 572,
   "dur": 227,
   "say": "It was so big it couldn't fit through the Suez Canal, the Panama Canal, or even the English Channel when it was fully loaded."
  },
  {
   "tpl": "stopping",
   "p": {},
   "cap": "",
   "from": 799,
   "dur": 162,
   "say": "If the captain went full astern at top speed, it needed about nine kilometres to stop."
  },
  {
   "tpl": "names",
   "p": {},
   "cap": "",
   "from": 961,
   "dur": 185,
   "say": "And that fire wasn't the end. This ship was rebuilt, and sailed again under four new names."
  },
  {
   "tpl": "talk",
   "p": {
    "pose": "thinking",
    "bg": "navy"
   },
   "cap": "HOW?",
   "from": 1146,
   "dur": 136,
   "say": "So how do you build something this big... and why did the world decide never to build one again?"
  }
 ],
