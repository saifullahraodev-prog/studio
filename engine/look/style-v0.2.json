{
  "version": "0.2",
  "note": "Draft look values for Phase 2. Becomes style-v1.0.json at GATE 2. Never change values inside a video.",
  "render": {
    "materials": "pbr",
    "envIntensity": 0.55,
    "note": "pbr = soft realistic materials (cloth, leather, metal reflections); toon = flat bands"
  },
  "toon": {
    "gradientSteps": [110, 185, 255],
    "outlines": false
  },
  "ink": {
    "paper": "#F2ECDF",
    "ink": "#2A2A30",
    "accent": "#E0907E",
    "grainOpacity": 0.1,
    "wobble": 0.6
