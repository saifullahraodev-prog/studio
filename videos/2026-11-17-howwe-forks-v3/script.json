  {
   "t": "exhibits",
   "in": "dolly",
   "pillar": "eat",
   "say": "The *knife*. Remember, every guest had a sharp, *pointed* blade.",
   "p": {
    "tag": "THE OTHER TOOL",
    "word": "The knife.",
    "items": [
     {
      "obj": "knife",
      "meta": "EVERY GUEST",
